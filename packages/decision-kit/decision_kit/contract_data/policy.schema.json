{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "Local application acceptance and labeled quality profile",
  "properties": {
    "require_confidence": {
      "type": "boolean"
    },
    "require_probabilities": {
      "type": "boolean"
    },
    "require_usage": {
      "type": "boolean"
    },
    "minimum_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "bypass_confidence_choices": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "uniqueItems": true
      }
    },
    "expected_choices": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    }
  }
}
