{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Provider-neutral finite-choice task v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_version",
    "task_id",
    "rules_version",
    "state",
    "questions"
  ],
  "properties": {
    "task_version": {
      "const": "bounded-task/1"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "rules_version": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "state": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "minProperties": 1
        },
        {
          "type": "array",
          "minItems": 1
        }
      ]
    },
    "questions": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 20,
      "propertyNames": {
        "minLength": 1,
        "pattern": "\\S"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "instructions",
          "criteria"
        ],
        "properties": {
          "type": {
            "const": "choice"
          },
          "instructions": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "criteria": {
            "type": "object",
            "minProperties": 2,
            "propertyNames": {
              "minLength": 1,
              "pattern": "\\S"
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "abstain_choice": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    }
  }
}
